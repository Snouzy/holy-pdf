{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Holy PDF",
  "version": "0.1.0",
  "identifier": "com.snouzylabs.holypdf",
  "build": {
    "devUrl": "http://localhost:4321",
    "frontendDist": "../../web/dist",
    "beforeBuildCommand": "pnpm --filter @holy-pdf/web build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
