{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Holy PDF",
  "version": "0.1.0",
  "identifier": "com.snouzylabs.holypdf",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm app:dev",
    "frontendDist": "../dist-app",
    "beforeBuildCommand": "pnpm app:build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
