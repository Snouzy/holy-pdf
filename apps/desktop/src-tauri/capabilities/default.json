{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own page may ask of the shell",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:allow-read-file",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$TEMP/**" }] },
    "opener:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "$HOME/**" }, { "path": "/Volumes/**" }, { "path": "$TEMP/**" }] },
    "window-state:default"
  ]
}
