{
  "name": "@holy-pdf/desktop",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "smoke": "pnpm smoke:engine && pnpm smoke:site",
    "smoke:engine": "tauri build --debug --no-bundle --config src-tauri/tauri.smoke.conf.json && src-tauri/target/debug/holy-pdf --smoke",
    "smoke:site": "tauri build --debug --no-bundle && src-tauri/target/debug/holy-pdf --smoke fr fr/compresser-pdf fr/faq en"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/emscripten": "1.41.6",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  }
}
