    },
    "The preview could not be displayed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’aperçu n’a pas pu être affiché."
          }
        }
      }
    },
    "The saved copies will not require a password." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies enregistrées ne demanderont pas de mot de passe."
