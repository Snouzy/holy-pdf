    "The page could not be rendered." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page n'a pas pu être rendue."
          }
        }
      }
    },
    "The page could not be updated." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page n'a pas pu être mise à jour."
          }
        }
      }
    },
    "The page has an unusual shape." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page a une forme inhabituelle."
          }
        }
      }
    },
    "The page is found, cropped and flattened. You can still move its corners." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La page est trouvée, recadrée et remise à plat. Les coins restent ajustables."
          }
        }
      }
    },
    "The pages follow the reading order and their text stays text. The links and the bookmarks do not follow." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages suivent l'ordre de lecture et leur texte reste du texte. Les liens et les signets ne suivent pas."
          }
        }
      }
    },
    "The pages that already have their text stay as they are." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les pages qui ont déjà leur texte restent telles quelles."
          }
        }
      }
    },
    "The photos slim down, the words stay" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos maigrissent, les mots restent"
          }
        }
