    "The signature placements have not been saved. Opening another PDF will discard them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les signatures placées n’ont pas été enregistrées. Ouvrir un autre PDF les supprimera."
