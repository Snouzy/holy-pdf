    },
    "The PDF could not be opened. Choose a readable file under 256 MB." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir ce PDF. Choisissez un fichier lisible de moins de 256 Mo."
          }
        }
      }
    },
    "The PDF could not be saved. Check the folder access and the free space. Your images have not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF n'a pas pu être enregistré. Vérifiez l'accès au dossier et l'espace libre. Vos images n'ont pas changé."
          }
        }
      }
    },
    "The PDF could not be saved. Choose another location." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’enregistrer le PDF. Choisissez un autre emplacement."
          }
        }
      }
    },
    "The PDF of this list has not been saved." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF de cette liste n'a pas été enregistré."
          }
        }
      }
    },
    "The Word document could not be written. Check the folder access and the free space." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le document Word n'a pas pu être écrit. Vérifiez l'accès au dossier et l'espace libre."
          }
        }
      }
    },
    "The copy could not be written. Your original PDF has not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie n'a pas pu être écrite. Votre PDF original n'a pas changé."
          }
        }
      }
    },
    "The copy is encrypted in AES-128. A long password protects it better." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie est chiffrée en AES-128. Un mot de passe long la protège mieux."
          }
        }
      }
    },
    "The copy will open without a password, with no limit on printing or copying." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie s'ouvrira sans mot de passe, sans limite d'impression ni de copie."
          }
        }
      }
    },
    "The current list has not been saved as a merged PDF. Your original files will stay unchanged." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette liste n’a pas été enregistrée en un PDF fusionné. Vos fichiers originaux resteront intacts."
          }
        }
      }
    },
    "The documents you have not exported will be lost." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les documents que vous n'avez pas exportés seront perdus."
          }
        }
      }
    },
    "The filled fields and the annotations become part of the page: they look the same and can no longer be changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les champs remplis et les annotations deviennent partie de la page : ils gardent leur aspect et ne se modifient plus."
          }
        }
      }
    },
    "The images could not be written. Check the folder access and the free space." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images n'ont pas pu être écrites. Vérifiez l'accès au dossier et l'espace libre."
          }
        }
      }
    },
    "The lines read are highlighted on the page." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lignes lues sont surlignées sur la page."
          }
        }
      }
    },
    "The merge was cancelled. Your original PDFs have not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fusion a été annulée. Vos PDF originaux restent intacts."
          }
        }
      }
    },
    "The merged copy will not require a password." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF fusionné s’ouvrira sans mot de passe."
          }
        }
      }
    },
    "The monk copies the text, its size and its style, paragraph by paragraph, and the pictures where they stand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moine recopie le texte, sa taille et son style, paragraphe par paragraphe, et les images à leur place."
          }
        }
      }
    },
    "The monk reads the pages that have no text and lays what he reads over them, invisible. You can then search the PDF and copy its text." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moine lit les pages sans texte et pose ce qu'il lit par-dessus, invisible. Vous pouvez ensuite chercher dans le PDF et copier son texte."
          }
        }
      }
    },
    "The new password replaces the one of the original." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nouveau mot de passe remplace celui de l'original."
          }
        }
      }
    },
    "The operation could not be completed. Your original PDF has not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’opération n’a pas abouti. Votre PDF original reste intact."
          }
        }
      }
    },
    "The operation could not be completed. Your original PDFs have not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
