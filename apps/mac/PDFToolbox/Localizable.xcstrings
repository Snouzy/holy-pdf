            "value" : "La lecture du texte n'est pas disponible."
          }
        }
      }
    },
    "Text recognition suggests how to group and name the pages. You confirm, one PDF per document." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture du texte propose les regroupements et les noms. Vous validez : un PDF par document."
