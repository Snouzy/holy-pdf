    },
    "The split stopped after file %lld of %lld. The files already written stay in the folder." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La division s’est arrêtée après le fichier %lld sur %lld. Les fichiers déjà écrits restent dans le dossier."
          }
        }
      }
    },
    "The text could not be read: this page has no text layer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte n'a pas pu être lu : cette page n'a pas de couche de texte."
          }
        }
      }
    },
    "The text is left out: you get only the photos, as they are in the PDF." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte est laissé de côté : vous récupérez seulement les photos, telles qu'elles sont dans le PDF."
          }
        }
      }
    },
    "The text of a page could not be read. Your original PDF has not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte d'une page n'a pas pu être lu. Votre PDF original n'a pas changé."
          }
        }
      }
    },
    "The text stays selectable at every level." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte reste sélectionnable, à tous les niveaux."
          }
        }
      }
    },
    "The text stays text, and the links stay links." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte reste du texte, et les liens restent des liens."
          }
        }
      }
    },
    "The text stays text. A link or a field stays on the half that shows it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte reste du texte. Un lien ou un champ reste sur la moitié qui le montre."
          }
        }
      }
    },
    "The two passwords are different." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux mots de passe sont différents."
          }
        }
