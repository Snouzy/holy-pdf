    "200 dpi, real page format (A4, A5). The GPS position of the photos is never copied into the PDFs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "200 dpi, format réel (A4, A5). La position GPS des photos n'est jamais copiée dans les PDF."
          }
        }
      }
    },
    "A PDF takes up to 200 images." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un PDF prend jusqu'à 200 images."
          }
        }
      }
    },
    "A PDF without its password" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un PDF sans son mot de passe"
          }
        }
      }
    },
    "A balance between size and image quality." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un équilibre entre taille et qualité d'image."
          }
        }
      }
    },
    "A hidden corner was rebuilt: check it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coin caché a été reconstruit : vérifiez-le."
          }
        }
      }
    },
    "A page could not be rendered again: the PDF keeps its last good render." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page n'a pas pu être recalculée : le PDF garde son dernier rendu réussi."
          }
        }
      }
    },
    "A page could not be turned into an image. Your original PDF has not changed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page n'a pas pu être changée en image. Votre PDF original n'a pas changé."
          }
        }
      }
    },
    "A page that carries a black area becomes an image: what the area covers is no longer in the file. On that page, the text can no longer be selected, and the links, notes and form fields are removed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une page qui porte une zone noire devient une image : ce que la zone couvre n'est plus dans le fichier. Sur cette page, le texte ne peut plus être sélectionné, et les liens, les notes et les champs de formulaire sont retirés."
          }
        }
      }
    },
    "A password on your PDF" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot de passe sur votre PDF"
          }
        }
      }
    },
    "A ribbon on every chapter" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un signet à chaque chapitre"
