{
  "name": "@holy-pdf/web",
  "private": true,
  "license": "SEE LICENSE IN LICENSING.md",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-ocr.mjs && node scripts/copy-scan.mjs && astro dev",
    "build": "node scripts/copy-ocr.mjs && node scripts/copy-scan.mjs && astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "e2e": "playwright test --project chromium --project firefox --project webkit",
    "lighthouse": "lhci autorun",
    "serve": "wrangler dev --port 8787",
    "test:seo": "vitest run --project seo",
    "bench": "playwright test --project bench --workers 1",
    "verify": "pnpm check && pnpm test && pnpm build && pnpm test:seo && playwright test --project chromium",
    "verify:full": "pnpm check && pnpm test && pnpm build && pnpm test:seo && pnpm e2e && INDEXABLE=true pnpm build && pnpm lighthouse"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@embedpdf/pdfium": "2.15.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@wasm-zoo/qpdf": "0.1.1",
    "astro": "7.3.5",
    "fflate": "0.8.3",
    "libheif-js": "1.23.2",
    "preact": "10.29.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/ron": "1.0.0",
    "@types/emscripten": "1.41.6",
    "@types/node": "24.7.0",
    "jpeg-js": "0.4.4",
    "pdfjs-dist": "6.3.289",
    "preact-render-to-string": "6.7.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "wrangler": "4.143.1"
  }
}
