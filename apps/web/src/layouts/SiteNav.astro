---
import { byCategory, type Category } from "../cast";
import { dictionaries } from "../i18n";
import { Icon } from "../illustrations/Icon";
import { Monk } from "../illustrations/Monk";
import { ToolIcon } from "../illustrations/ToolIcon";
import { homePath, siteName, sourceUrl, toolPath } from "../site";
import { type Lang, languageNames, languages, locales, tools } from "../tools";

type Props = { lang: Lang; paths: Record<Lang, string> };

const { lang, paths } = Astro.props;
const t = dictionaries[lang];
const others = languages.filter((candidate) => candidate !== lang);
const groups = byCategory();
const convert = groups.find(({ category }) => category === "convert");
const tint = (category: Category) => `--tool: var(--${category}); --tool-tint: var(--${category}-tint)`;
// Simple Icons 16.33.0, CC0-1.0, like the footer's icons.
const github = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
---

<header class="site-header">
  <div class="nav-bar">
    <a class="brand" href={homePath(lang)}>
      <span class="brand-mark"><Monk size={40} halo /></span>
      <span class="brand-name">{siteName}</span>
    </a>
    <nav class="site-nav" id="site-nav" aria-label={t.nav.label}>
      <ul class="nav-links">
        {(["merge", "sign", "compress"] as const).map((id) => {
          const href = toolPath(tools[id], lang);
          return (
            <li>
              <a class="nav-link" href={href} aria-current={href === paths[lang] ? "page" : undefined}>{t.nav.tools[id]}</a>
            </li>
          );
        })}
        {convert && (
          <li>
            <details class="nav-menu convert-menu" name="nav">
              <summary class="nav-link">{t.nav.convert}</summary>
              <ul class="drop" style={tint("convert")}>
                {convert.ready.map((id) => (
                  <li>
                    <a href={toolPath(tools[id], lang)}><span class="tool-icon"><ToolIcon id={id} /></span>{t.toolShort[id]}</a>
                  </li>
                ))}
                {convert.sleeping.map((id) => (
                  <li class="soon"><span class="tool-icon"><ToolIcon id={id} /></span>{t.upcoming[id]}<span class="badge">{t.nav.soon}</span></li>
                ))}
              </ul>
            </details>
          </li>
        )}
        <li>
          <details class="nav-menu tools-menu" name="nav">
            <summary class="nav-link">{t.nav.all}</summary>
            <div class="mega">
              {groups.map(({ category, ready, sleeping }) => (
                <div class:list={["mega-col", { asleep: ready.length === 0 }]} style={tint(category)}>
                  <p class="mega-head">{t.categories[category]}</p>
                  <ul>
                    {ready.map((id) => (
                      <li>
                        <a href={toolPath(tools[id], lang)}><span class="tool-icon"><ToolIcon id={id} /></span>{t.toolShort[id]}</a>
                      </li>
                    ))}
                    {sleeping.map((id) => (
                      <li class="soon"><span class="tool-icon"><ToolIcon id={id} /></span>{t.upcoming[id]}<span class="badge">{t.nav.soon}</span></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        </li>
      </ul>
      <div class="drawer-languages">
        {others.map((other) => <a class="language" href={paths[other]} hreflang={locales[other]} lang={locales[other]}><Icon name="globe" size={18} />{languageNames[other]}</a>)}
      </div>
    </nav>
    <div class="nav-actions">
      <a class="github" href={sourceUrl} aria-label={t.nav.github}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d={github} /></svg>
      </a>
      <button class="theme-toggle" type="button" data-toggle="theme" aria-pressed="false" aria-label={t.menu.darkMode}>
        <span class="theme-moon"><Icon name="moon" size={22} /></span>
        <span class="theme-sun"><Icon name="sun" size={22} /></span>
      </button>
      <details class="nav-menu language-menu" name="nav">
        <summary class="language"><Icon name="globe" size={18} /><span class="visually-hidden">{t.nav.language}: </span>{languageNames[lang]}</summary>
        <ul class="drop language-drop">
          {others.map((other) => <li><a href={paths[other]} hreflang={locales[other]} lang={locales[other]}>{languageNames[other]}</a></li>)}
        </ul>
      </details>
      <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={t.nav.menu}>
        <span class="burger-open"><Icon name="menu" size={22} /></span>
        <span class="burger-close"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header { position: fixed; inset: 0 0 auto; z-index: 15; border-bottom: 1px solid transparent; transition: background-color 0.2s, border-color 0.2s; }
  :global([data-scrolled]) .site-header, :global([data-menu="open"]) .site-header { background: var(--surface); border-bottom-color: var(--line); }
  .nav-bar {
    position: relative; display: flex; align-items: center; gap: 2rem; max-width: 82rem; height: var(--nav-height);
    margin: 0 auto; padding: 0 1rem; transition: height 0.2s;
  }
  .brand {
    display: flex; flex-shrink: 0; align-items: center; gap: 0.625rem;
    font-family: var(--font-title); font-weight: 800; font-size: 1.75rem; letter-spacing: -0.03em; color: var(--ink); text-decoration: none;
  }
  .brand-mark {
    display: flex; align-items: flex-end; justify-content: center; width: 48px; height: 48px; overflow: hidden; border-radius: 50%; background: var(--highlight);
    transition: transform 150ms ease-out;
  }
  .nav-links { display: flex; align-items: center; gap: 1.75rem; margin: 0; padding: 0; list-style: none; }
  .nav-link {
    display: flex; align-items: center; gap: 0.375rem; min-height: 44px; font-weight: 800; font-size: 0.875rem; letter-spacing: 0.03em;
    text-transform: uppercase; white-space: nowrap; color: var(--ink); text-decoration: none; cursor: pointer; list-style: none;
  }
  summary.nav-link::-webkit-details-marker { display: none; }
  summary.nav-link::after {
    content: ""; width: 0.4rem; height: 0.4rem; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }
  .nav-menu[open] > summary.nav-link::after { transform: translateY(2px) rotate(-135deg); }
  .nav-link[aria-current="page"], .nav-menu[open] > .nav-link { text-decoration: underline 3px var(--accent); text-underline-offset: 0.55em; }
  .nav-menu { position: relative; }
  .tools-menu { position: static; }
  .drop, .mega {
    position: absolute; z-index: 1; margin: 0; padding: 0.625rem; list-style: none;
    background: var(--surface); border-radius: var(--radius-panel); box-shadow: var(--shadow-lifted);
  }
  .drop { top: calc(100% + 0.75rem); left: -1rem; width: 18rem; }
  .mega { top: 100%; left: 1rem; right: 1rem; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.625rem; padding: 1.625rem 1.75rem; }
  .mega ul { margin: 0; padding: 0; list-style: none; }
  .mega-head {
    margin: 0 0 0.5rem; padding-bottom: 0.5rem; border-bottom: 3px solid var(--tool); color: var(--tool);
    font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.06em; text-transform: uppercase;
  }
  .drop a, .mega a, .soon { display: flex; align-items: center; gap: 0.75rem; min-height: 44px; padding: 0.25rem; border-radius: var(--radius-control); font-size: 0.9375rem; }
  .drop a, .mega a { font-weight: 700; color: var(--ink); text-decoration: none; }
  .soon { color: var(--muted); }
  .tool-icon { display: grid; flex-shrink: 0; place-items: center; width: 36px; height: 36px; border-radius: 10px; background: var(--tool-tint); color: var(--tool); }
  .soon .tool-icon { background: var(--upcoming); color: var(--muted); }
  .badge {
    margin-inline-start: auto; padding: 0 0.375rem; border: 1.5px solid var(--line); border-radius: 6px;
    font-size: 0.6875rem; font-weight: 800; text-transform: uppercase;
  }
  .nav-actions { display: flex; align-items: center; gap: 0.625rem; margin-inline-start: auto; }
  .theme-toggle, .burger, .github {
    display: inline-flex; flex-shrink: 0; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0;
    border: 1.5px solid var(--line); border-radius: var(--radius-control); background: var(--surface); color: var(--ink); cursor: pointer;
  }
  .language {
    display: inline-flex; align-items: center; gap: 0.375rem; min-height: 44px; padding: 0 0.75rem; border: 1.5px solid var(--line);
    border-radius: var(--radius-control); background: var(--surface); font-weight: 700; font-size: 0.875rem; color: var(--ink); text-decoration: none;
  }
  summary.language { list-style: none; cursor: pointer; }
  summary.language::-webkit-details-marker { display: none; }
  .language-drop { left: auto; right: 0; width: 12rem; }
  .language-drop a { padding-inline: 0.75rem; }
  :global(:root:not([data-theme])) .theme-toggle, .theme-sun, :global([data-theme="dark"]) .theme-moon { display: none; }
  .theme-moon, .burger-open, :global([data-theme="dark"]) .theme-sun { display: contents; }
  .burger, .burger-close, .drawer-languages { display: none; }

  @media (max-width: 78rem) {
    .nav-links { gap: 1.125rem; }
  }
  @media (max-width: 75rem) {
    .nav-bar { gap: 0.5rem; }
    .brand { margin-inline-end: auto; }
    .burger { display: inline-flex; }
    .language-menu { display: none; }
    :global([data-menu="open"]) .burger-open { display: none; }
    :global([data-menu="open"]) .burger-close { display: contents; }
    :global([data-menu="open"] body) { overflow: hidden; }
    .site-nav { display: none; position: fixed; inset: var(--nav-height) 0 0; overflow-y: auto; padding: 0.5rem 1rem 2rem; background: var(--bg); }
    :global([data-menu="open"]) .site-nav { display: block; }
    .nav-links { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-links > li { border-bottom: 1px solid var(--line); }
    .nav-link { justify-content: space-between; min-height: 3.5rem; font-size: 1.0625rem; letter-spacing: 0; text-transform: none; }
    .nav-link[aria-current="page"], .nav-menu[open] > .nav-link { text-decoration: none; }
    .nav-link[aria-current="page"] { color: var(--accent); }
    .drop, .mega { position: static; width: auto; padding: 0 0 1rem; background: none; box-shadow: none; }
    .mega { display: flex; flex-direction: column; gap: 1rem; }
    .mega-col.asleep, .soon { display: none; }
    .drop, .mega ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; }
    .drop a, .mega a { background: var(--surface); }
    .drawer-languages { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.25rem; }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .brand:hover .brand-mark { transform: rotate(-8deg) scale(1.06); }
  }
  @media (max-width: 480px) {
    .brand-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
  @media (hover: hover) {
    .brand:hover { color: var(--accent); }
    .nav-link:hover { color: var(--accent); text-decoration: underline 3px; text-underline-offset: 0.55em; }
    .drop a:hover, .mega a:hover { background: var(--accent-tint); color: var(--accent); }
    .theme-toggle:hover, .burger:hover, .language:hover, .github:hover { border-color: var(--accent); background: var(--accent-tint); color: var(--accent); }
  }
</style>
