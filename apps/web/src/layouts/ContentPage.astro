---
import { formatDate, pageTexts } from "../i18n/pages";
import { author } from "../sitePages";
import type { Lang } from "../tools";
import Base from "./Base.astro";
import Emoji from "./Emoji.astro";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  paths: Record<Lang, string>;
  jsonLd: object[];
  h1: string;
  emoji: string;
  lead: string;
  updated?: Date | undefined;
  published?: Date | undefined;
};

const { lang, title, description, paths, jsonLd, h1, emoji, lead, updated, published } = Astro.props;
const texts = pageTexts[lang];
---

<Base lang={lang} title={title} description={description} paths={paths} jsonLd={jsonLd}>
  <header class="page-head">
    <slot name="art" />
    <h1>{h1}<Emoji char={emoji} /></h1>
    <p class="lead">{lead}</p>
    {published && <p class="meta">{formatDate(published, lang)} · {author}</p>}
    {updated && <p class="meta">{texts.updated(formatDate(updated, lang))}</p>}
  </header>
  <div class="prose">
    <slot />
  </div>
  <slot name="after" />
</Base>

<style>
  .page-head { display: flex; flex-direction: column; align-items: center; gap: 0.875rem; padding-top: 3.5rem; text-align: center; }
  h1 { max-width: 52rem; margin: 0; overflow-wrap: anywhere; text-wrap: balance; }
  .lead { max-width: 39rem; margin: 0; font-size: 1.3125rem; line-height: 1.45; color: var(--ink-soft); }
  .meta { margin: 0; font-size: 0.9375rem; font-weight: 700; color: var(--ink-soft); }
  .prose { max-width: 48rem; margin: 3rem auto 0; font-size: 1.0625rem; }
  .prose :global(h2) { margin: 2.5rem 0 0.75rem; font-size: clamp(1.5rem, 2.5vw, 1.875rem); }
  .prose :global(:is(p, ul, ol, table)) { margin: 0 0 1rem; }
  .prose :global(:is(p, li, td)) { color: var(--ink-soft); }
  .prose :global(li + li) { margin-top: 0.375rem; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(table) { width: 100%; border-collapse: collapse; }
  .prose :global(:is(th, td)) { padding: 0.625rem 0.75rem; border-bottom: 1px solid var(--line); text-align: start; vertical-align: top; overflow-wrap: anywhere; }
  .prose :global(.article-visual) { margin: 1.75rem 0; }
  .prose :global(.article-visual img) {
    display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: var(--radius-panel); background: var(--surface); box-shadow: var(--shadow-panel);
  }
  .prose :global(.article-visual figcaption) { margin-top: 0.625rem; font-size: 0.9375rem; color: var(--ink-soft); text-align: center; }
  .prose :global(.article-visual--hero) { margin-top: 0; }
  @media (max-width: 30rem) {
    h1 { hyphens: auto; }
    .prose :global(:is(th, td)) { padding-inline: 0.375rem; }
  }
  @media (max-width: 900px) {
    .page-head { padding-top: 1.5rem; }
    .lead { font-size: 1.0625rem; }
  }
</style>
