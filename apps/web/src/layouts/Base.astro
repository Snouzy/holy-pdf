---
import { ClientRouter } from "astro:transitions";
import { dictionaries } from "../i18n";
import { fontFaces, preloadedFonts } from "../styles/fonts";
import "../styles/tokens.css";
import { type Lang, languages } from "../tools";
import SiteFooter from "./SiteFooter.astro";
import SiteNav from "./SiteNav.astro";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  paths: Record<Lang, string>;
  jsonLd?: object[];
  /** The router keeps the board across a language switch, and carries the files of the home drop zone to a tool page. */
  clientRouter?: boolean;
};

const { lang, title, description, paths, jsonLd = [], clientRouter = false } = Astro.props;
// Pages stay out of search engines until the site has its own domain: set INDEXABLE=true at build time.
const indexable = process.env.INDEXABLE === "true";
const t = dictionaries[lang];
const url = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadedFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Fragment set:html={`<style>${fontFaces}</style>`} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = matchMedia("(prefers-color-scheme: dark)");
        const toggles = {
          theme: { on: "dark", off: "light", auto: () => (system.matches ? "dark" : "light") },
          view: { on: "compact", off: "cards", auto: () => "cards" },
        };
        const chosen = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
        const set = (doc, key, value) => {
          doc.documentElement.dataset[key] = value;
          for (const button of doc.querySelectorAll(`[data-toggle="${key}"]`)) button.setAttribute("aria-pressed", String(value === toggles[key].on));
        };
        const paint = (doc) => {
          for (const key in toggles) set(doc, key, chosen(key) ?? toggles[key].auto());
        };
        const scrolled = () => root.toggleAttribute("data-scrolled", scrollY > 24);
        const drawer = (open) => {
          if (open) root.dataset.menu = "open";
          else delete root.dataset.menu;
          document.querySelector(".burger")?.setAttribute("aria-expanded", String(open));
          for (const region of document.querySelectorAll("main, .site-footer")) region.inert = open;
        };
        paint(document);
        scrolled();
        document.addEventListener("DOMContentLoaded", () => paint(document));
        system.addEventListener("change", () => paint(document));
        document.addEventListener("astro:before-swap", (event) => paint(event.newDocument));
        document.addEventListener("astro:after-swap", scrolled);
        addEventListener("scroll", scrolled, { passive: true });
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target?.closest(".site-nav details")) for (const menu of document.querySelectorAll(".site-nav details[open]")) menu.open = false;
          if (target?.closest(".burger")) drawer(root.dataset.menu !== "open");
          const key = target?.closest("[data-toggle]")?.getAttribute("data-toggle");
          if (!key) return;
          const value = root.dataset[key] === toggles[key].on ? toggles[key].off : toggles[key].on;
          try { localStorage.setItem(key, value); } catch {}
          set(document, key, value);
        });
        // Safari does not focus a clicked button or link, so a press of Escape after a click comes from the body.
        document.addEventListener("keydown", (event) => {
          const from = event.target instanceof Element ? event.target : null;
          if (event.key !== "Escape" || !(from === document.body || from?.closest(".site-header"))) return;
          const menu = document.querySelector(".site-nav details[open]");
          if (menu) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          } else if (root.dataset.menu === "open") {
            drawer(false);
            document.querySelector(".burger")?.focus();
          }
        });
        // relatedTarget is null when Safari leaves focus on the body after a click: the click handler closes the menu then.
        document.addEventListener("focusout", (event) => {
          const menu = event.target instanceof Element ? event.target.closest(".site-nav details[open]") : null;
          if (menu && event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
        });
        // A drawer left open while the window grows past the breakpoint would keep the page inert and hidden from view.
        matchMedia("(max-width: 75rem)").addEventListener("change", () => drawer(false));
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {clientRouter && <ClientRouter />}
    <link rel="canonical" href={url(paths[lang])} />
    {languages.map((code) => <link rel="alternate" hreflang={code} href={url(paths[code])} />)}
    <link rel="alternate" hreflang="x-default" href={url(paths.en)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <SiteNav lang={lang} paths={paths} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} paths={paths} />
    <div class="drop-overlay" aria-hidden="true"><p>{t.drop.release}</p></div>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--font-text); line-height: 1.5; }
  .scroll::-webkit-scrollbar { width: 14px; height: 14px; }
  .scroll::-webkit-scrollbar-track { margin: 8px; background: transparent; }
  .scroll::-webkit-scrollbar-thumb { border: 4px solid transparent; border-radius: 999px; background: color-mix(in srgb, var(--ink) 22%, transparent) padding-box; }
  .scroll::-webkit-scrollbar-thumb:hover { background-color: color-mix(in srgb, var(--ink) 40%, transparent); }
  @supports (-moz-appearance: none) {
    .scroll { scrollbar-width: thin; scrollbar-color: color-mix(in srgb, var(--ink) 30%, transparent) transparent; }
  }
  :root { --nav-top: 5rem; --nav-height: var(--nav-top); scroll-padding-top: calc(var(--nav-height) + 1rem); }
  :root[data-scrolled] { --nav-height: 4rem; }
  body { padding-top: var(--nav-top); }
  main { max-width: 82rem; margin: 0 auto; padding: 0 1rem; }
  a { color: var(--accent); }
  :where(a, button, summary, label) { transition: background-color 150ms, border-color 150ms, color 150ms, box-shadow 150ms, transform 150ms; }
  @media (hover: hover) {
    a:hover { color: var(--accent-hover); }
    .lift:hover { transform: translateY(-2px); }
    /* The lifted card still covers the 2 px it left, or a pointer there would turn the hover on and off. The inset counts from inside
       the border (up to 2 px), and the transform makes the card the containing block. */
    .lift:hover::after { content: ""; position: absolute; inset: 0 0 -4px; }
  }
  .drop-overlay {
    position: fixed; inset: 0; z-index: 20; display: none; place-items: center; pointer-events: none;
    background: color-mix(in srgb, var(--bg) 80%, transparent); outline: 4px dashed var(--accent); outline-offset: -16px;
  }
  [data-dropping] .drop-overlay { display: grid; }
  .drop-overlay p {
    margin: 0; padding: 1rem 1.5rem; border-radius: var(--radius-panel); background: var(--surface); box-shadow: var(--shadow-panel);
    font-family: var(--font-title); font-weight: 800; font-size: 1.75rem; color: var(--ink);
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  h1, h2, h3 { font-family: var(--font-title); font-weight: 800; color: var(--ink); }
  h1 { font-size: clamp(2.5rem, 5vw, 4.25rem); line-height: 0.98; letter-spacing: -0.037em; margin: 1rem 0; }
  h2 { font-size: clamp(1.625rem, 3vw, 2.5rem); line-height: 1.1; letter-spacing: -0.035em; }
  h3 { font-size: 1.5rem; line-height: 1.1; letter-spacing: -0.02em; }
  button { font: inherit; }
  /* Once here rather than on each of the menu's icons, which every page repeats. */
  .tool-glyph { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .highlight {
    background: linear-gradient(transparent var(--highlight-from), var(--highlight) var(--highlight-from), var(--highlight) 92%, transparent 92%);
    color: var(--on-highlight);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  @media (max-width: 75rem) {
    :root { --nav-top: 4.5rem; }
    :root[data-scrolled] { --nav-height: 3.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
