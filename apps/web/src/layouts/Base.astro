---
import { ClientRouter } from "astro:transitions";
import { dictionaries } from "../i18n";
import { fontFaces, preloadedFonts } from "../styles/fonts";
import "../styles/tokens.css";
import "../styles/base.css";
import { type Lang, languages } from "../tools";
import Consent from "./Consent.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteNav from "./SiteNav.astro";

type Props = {
  lang: Lang;
  title: string;
  description: string;
  paths: Record<Lang, string>;
  jsonLd?: object[];
  ogType?: "website" | "article";
  image?: string | undefined;
  /** The router keeps the board across a language switch. */
  clientRouter?: boolean;
};

const { lang, title, description, paths, jsonLd = [], ogType = "website", image, clientRouter = false } = Astro.props;
// Pages stay out of search engines until the site has its own domain: set INDEXABLE=true at build time.
const indexable = process.env.INDEXABLE === "true";
const measurementId = process.env.GA4_ID || undefined;
if (measurementId && !/^G-[A-Z0-9]+$/.test(measurementId)) throw new Error(`GA4_ID is not a GA4 measurement ID: ${measurementId}`);
const t = dictionaries[lang];
const url = (path: string) => new URL(path, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadedFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Fragment set:html={`<style>${fontFaces}</style>`} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const system = matchMedia("(prefers-color-scheme: dark)");
        const toggles = {
          theme: { on: "dark", off: "light", auto: () => (system.matches ? "dark" : "light") },
          view: { on: "compact", off: "cards", auto: () => "cards" },
        };
        const chosen = (key) => { try { return localStorage.getItem(key); } catch { return null; } };
        const set = (doc, key, value) => {
          doc.documentElement.dataset[key] = value;
          for (const button of doc.querySelectorAll(`[data-toggle="${key}"]`)) button.setAttribute("aria-pressed", String(value === toggles[key].on));
        };
        const paint = (doc) => {
          for (const key in toggles) set(doc, key, chosen(key) ?? toggles[key].auto());
        };
        const scrolled = () => root.toggleAttribute("data-scrolled", scrollY > 24);
        const drawer = (open) => {
          if (open) root.dataset.menu = "open";
          else delete root.dataset.menu;
          document.querySelector(".burger")?.setAttribute("aria-expanded", String(open));
          for (const region of document.querySelectorAll("main, .site-footer")) region.inert = open;
        };
        paint(document);
        scrolled();
        document.addEventListener("DOMContentLoaded", () => paint(document));
        system.addEventListener("change", () => paint(document));
        document.addEventListener("astro:before-swap", (event) => paint(event.newDocument));
        document.addEventListener("astro:after-swap", scrolled);
        addEventListener("scroll", scrolled, { passive: true });
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (!target?.closest(".site-nav details")) for (const menu of document.querySelectorAll(".site-nav details[open]")) menu.open = false;
          if (target?.closest(".burger")) drawer(root.dataset.menu !== "open");
          const key = target?.closest("[data-toggle]")?.getAttribute("data-toggle");
          if (!key) return;
          const value = root.dataset[key] === toggles[key].on ? toggles[key].off : toggles[key].on;
          try { localStorage.setItem(key, value); } catch {}
          set(document, key, value);
        });
        // Safari does not focus a clicked button or link, so a press of Escape after a click comes from the body.
        document.addEventListener("keydown", (event) => {
          const from = event.target instanceof Element ? event.target : null;
          if (event.key !== "Escape" || !(from === document.body || from?.closest(".site-header"))) return;
          const menu = document.querySelector(".site-nav details[open]");
          if (menu) {
            menu.open = false;
            menu.querySelector("summary")?.focus();
          } else if (root.dataset.menu === "open") {
            drawer(false);
            document.querySelector(".burger")?.focus();
          }
        });
        // relatedTarget is null when Safari leaves focus on the body after a click: the click handler closes the menu then.
        document.addEventListener("focusout", (event) => {
          const menu = event.target instanceof Element ? event.target.closest(".site-nav details[open]") : null;
          if (menu && event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
        });
        // A drawer left open while the window grows past the breakpoint would keep the page inert and hidden from view.
        matchMedia("(max-width: 75rem)").addEventListener("change", () => drawer(false));
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content="Holy PDF" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(paths[lang])} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {!indexable && <meta name="robots" content="noindex" />}
    {clientRouter && <ClientRouter />}
    <link rel="canonical" href={url(paths[lang])} />
    {languages.map((code) => <link rel="alternate" hreflang={code} href={url(paths[code])} />)}
    <link rel="alternate" hreflang="x-default" href={url(paths.en)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <SiteNav lang={lang} paths={paths} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} paths={paths} consent={measurementId !== undefined} />
    {measurementId && <Consent lang={lang} measurementId={measurementId} />}
    <div class="drop-overlay" aria-hidden="true"><p>{t.drop.release}</p></div>
  </body>
</html>

<style is:global>
  /* The site's own bar and page width; what every page and the desktop app share is in styles/base.css. */
  :root { --nav-top: 5rem; --nav-height: var(--nav-top); scroll-padding-top: calc(var(--nav-height) + 1rem); }
  :root[data-scrolled] { --nav-height: 4rem; }
  body { padding-top: var(--nav-top); }
  main { max-width: 82rem; margin: 0 auto; padding: 0 1rem; }
  @media (max-width: 75rem) {
    :root { --nav-top: 4.5rem; }
    :root[data-scrolled] { --nav-height: 3.75rem; }
  }
</style>
