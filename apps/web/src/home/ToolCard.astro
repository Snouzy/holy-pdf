---
import { cast, upcoming, type UpcomingId } from "../cast";
import { dictionaries, searchTexts } from "../i18n";
import { Monk } from "../illustrations/Monk";
import { Scene } from "../illustrations/Scene";
import { ToolIcon } from "../illustrations/ToolIcon";
import { toolPath } from "../site";
import type { Lang, Tool } from "../tools";

type Props = { lang: Lang } & ({ tool: Tool } | { asleep: UpcomingId });

const { lang } = Astro.props;
const t = dictionaries[lang];
const tool = "tool" in Astro.props ? Astro.props.tool : null;
const asleep = "asleep" in Astro.props ? Astro.props.asleep : null;
const monk = tool ? cast[tool.id] : null;
---

{tool && monk && (
  <a class="tool-card lift" href={toolPath(tool, lang)} style={`--scene-accent: var(--${monk.category}); --card-tint: var(--${monk.category}-tint)`}>
    <span class="sheet">
      <span class="art">
        <span class="art-scene"><Scene kind={monk.scene} size={110} /></span>
        <span class="art-monk"><Monk accessory={monk.accessory} mood={monk.mood} size={112} /></span>
      </span>
      <span class="text">
        <span class="monk-name">{t.monks[tool.id].name}</span>
        <h3>{t.toolNames[tool.id]}</h3>
        <span class="line">{t.monks[tool.id].line}</span>
        <span class="open">{t.home.openTool}</span>
      </span>
    </span>
  </a>
)}
{asleep && (
  <div class="tool-card asleep" style={`--scene-accent: var(--${upcoming[asleep].category})`}>
    <span class="sheet">
      <span class="art"><ToolIcon id={asleep} size={64} /></span>
      <span class="text">
        <span class="monk-name">{t.categories[upcoming[asleep].category]}</span>
        <h3>{t.upcoming[asleep]}</h3>
        <span class="tag">{searchTexts[lang].soonTag}</span>
      </span>
    </span>
  </div>
)}

<style>
  .tool-card {
    display: block; height: 100%; color: var(--ink); text-decoration: none; filter: drop-shadow(var(--shadow-sheet));
    transition: transform 150ms, filter 150ms;
  }
  .sheet {
    position: relative; display: flex; flex-direction: column; height: 100%; background: var(--surface);
    clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 26px, 100% 100%, 0 100%);
  }
  .sheet::after {
    content: ""; position: absolute; top: 0; right: 0; width: 26px; height: 26px;
    background: linear-gradient(225deg, transparent 50%, var(--fold) 50%);
  }
  .art { position: relative; display: block; height: 150px; overflow: hidden; background: var(--card-tint); }
  .art-scene { position: absolute; right: 10px; top: 18px; line-height: 0; }
  .art-monk { position: absolute; left: 8px; bottom: 0; line-height: 0; }
  .asleep .art { display: grid; place-items: center; background: var(--upcoming); color: var(--muted); }
  .text { display: flex; flex-direction: column; gap: 0.375rem; padding: 0.875rem 1rem 1rem; }
  .monk-name { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--scene-accent); }
  h3 { margin: 0; font-size: 1.25rem; }
  .asleep h3 { color: var(--ink-soft); }
  .line { font-size: 0.875rem; color: var(--ink-soft); }
  .open { margin-top: 0.375rem; font-weight: 700; color: var(--accent); }
  .tag {
    align-self: flex-start; margin-top: 0.25rem; padding: 0.125rem 0.5rem; border: 1px solid var(--line); border-radius: 999px;
    font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted);
  }
  @media (max-width: 700px) {
    .art { height: 106px; }
    .art-scene { right: 4px; top: 10px; }
    .art-scene :global(svg) { width: 74px; height: 74px; }
    .art-monk { left: 2px; }
    .art-monk :global(svg) { width: 86px; height: auto; }
    .asleep .art :global(svg) { width: 48px; height: 48px; }
    .text { padding: 0.625rem 0.75rem 0.75rem; }
    h3 { font-size: 1rem; }
    .line, .open { display: none; }
    .tag { font-size: 0.625rem; letter-spacing: 0.02em; }
  }
  @media (hover: hover) {
    .tool-card[href]:hover { color: var(--ink); filter: drop-shadow(var(--shadow-sheet)) drop-shadow(var(--shadow-panel)); }
    .tool-card:hover .open { text-decoration: underline; }
  }
</style>
