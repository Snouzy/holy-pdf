---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { faqFromMarkdown, faqPage, questionId } from "../../faq";
import { dictionaries } from "../../i18n";
import { formatDate, pageTexts } from "../../i18n/pages";
import { Avatar } from "../../illustrations/Avatar";
import { Monk } from "../../illustrations/Monk";
import ContentPage from "../../layouts/ContentPage.astro";
import { alternates, homePath, siteName, toolPath } from "../../site";
import { articlePath, pagePath, sections, sitePages } from "../../sitePages";
import { toolIds, tools } from "../../tools";

export const getStaticPaths = (async () => {
  const entries = await getCollection("pages");
  return entries.map((entry) => ({ params: { lang: entry.data.lang, page: sitePages[entry.data.page].slug[entry.data.lang] }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { page, lang, title, description, h1, lead, updated } = entry.data;
const { Content } = await render(entry);
const t = dictionaries[lang];
const texts = pageTexts[lang];
const section = sections.find((id) => id === page);
const articles = section
  ? (await getCollection("articles", ({ data }) => data.section === section && data.lang === lang)).sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  : [];
const toolQuestions =
  page === "faq"
    ? (await getCollection("tools", ({ data }) => data.lang === lang))
        .sort((a, b) => toolIds.indexOf(a.data.tool) - toolIds.indexOf(b.data.tool))
        .map(({ data }) => ({ tool: tools[data.tool], questions: data.faq.map(({ question }) => question) }))
    : [];
const url = (path: string) => new URL(path, Astro.site).href;
const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: siteName, item: url(homePath(lang)) },
      { "@type": "ListItem", position: 2, name: h1, item: url(pagePath(page, lang)) },
    ],
  },
];
if (page === "faq") jsonLd.push(faqPage(faqFromMarkdown(entry.body ?? "")));
---

<ContentPage lang={lang} title={title} description={description} paths={alternates((code) => pagePath(page, code))} jsonLd={jsonLd} h1={h1} emoji={sitePages[page].emoji} lead={lead} updated={updated}>
  {page === "about" && <div slot="art"><Monk size={140} mood="joy" /></div>}
  {page === "apps" && (
    <div slot="art" class="asleep">
      <Avatar accessory="none" mood="sleep" diameter={110} tint="var(--upcoming)" />
      <p class="stamp">{t.nav.soon}</p>
    </div>
  )}
  <Content />
  {page === "faq" && (
    <section slot="after" class="more">
      <h2>{texts.toolQuestions}</h2>
      <div class="tool-questions">
        {toolQuestions.map(({ tool, questions }) => (
          <section>
            <h3><a href={toolPath(tool, lang)}>{t.toolNames[tool.id]}</a></h3>
            <ul>{questions.map((question) => <li><a href={`${toolPath(tool, lang)}#${questionId(question)}`}>{question}</a></li>)}</ul>
          </section>
        ))}
      </div>
    </section>
  )}
  {section && (
    <ul slot="after" class="more articles">
      {articles.map(({ data }) => (
        <li>
          <a class="lift" href={articlePath(section, data.slug, lang)}>
            <strong>{data.h1}</strong>
            <small>{formatDate(data.published, lang)}</small>
            <span>{data.lead}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</ContentPage>

<style>
  .asleep { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .stamp {
    margin: 0; padding: 0.375rem 0.875rem; border: 3px solid var(--stamp); border-radius: 6px; color: var(--stamp);
    font-family: var(--font-title); font-weight: 800; font-size: 0.9375rem; letter-spacing: 0.16em; text-transform: uppercase; transform: rotate(-2deg);
  }
  .more { max-width: 48rem; margin: 3rem auto 0; }
  .more h2 { margin: 0 0 1rem; font-size: clamp(1.5rem, 2.5vw, 1.875rem); }
  .tool-questions { columns: 2 18rem; column-gap: 2.5rem; }
  .tool-questions section { break-inside: avoid; padding-bottom: 1.5rem; }
  .tool-questions h3 { margin: 0 0 0.5rem; font-size: 1.25rem; }
  .tool-questions h3 a { color: var(--ink); text-decoration: none; }
  .tool-questions ul { margin: 0; padding-left: 1.25rem; }
  .tool-questions li { padding-block: 0.1875rem; }
  .articles { display: grid; gap: 1rem; padding: 0; list-style: none; }
  .articles a {
    position: relative; display: flex; flex-direction: column; gap: 0.25rem; padding: 1.25rem 1.5rem;
    border-radius: var(--radius-panel); background: var(--surface); color: var(--ink); text-decoration: none;
  }
  .articles strong { font-family: var(--font-title); font-weight: 800; font-size: 1.25rem; }
  .articles small { font-weight: 700; color: var(--ink-soft); }
  .articles span { color: var(--ink-soft); }
  @media (hover: hover) {
    .articles a:hover { color: var(--ink); box-shadow: var(--shadow-panel); }
  }
</style>
