---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import ArticleNavigation from "../../../components/ArticleNavigation.astro";
import { dictionaries } from "../../../i18n";
import { pageTexts } from "../../../i18n/pages";
import ContentPage from "../../../layouts/ContentPage.astro";
import { alternates, homePath, siteName } from "../../../site";
import { articlePath, pagePath, sitePages } from "../../../sitePages";

export const getStaticPaths = (async () => {
  const entries = await getCollection("articles");
  const fileName = (id: string) => id.slice(id.indexOf("/") + 1);
  return entries.map((entry) => {
    const { section, lang, slug } = entry.data;
    const paths = alternates((code) => {
      const sibling = entries.find((other) => other.data.lang === code && fileName(other.id) === fileName(entry.id));
      if (!sibling) throw new Error(`The article ${entry.id} has no ${code} version`);
      return articlePath(sibling.data.section, sibling.data.slug, code);
    });
    const related = entries
      .filter((other) => other.id !== entry.id && other.data.lang === lang)
      .map((other) => ({
        entry: other,
        score: other.data.topics.filter((topic) => entry.data.topics.includes(topic)).length * 10 + Number(other.data.section === section),
      }))
      .sort((a, b) => b.score - a.score || b.entry.data.published.getTime() - a.entry.data.published.getTime() || a.entry.data.slug.localeCompare(b.entry.data.slug))
      .slice(0, 2)
      .map(({ entry: relatedEntry }) => relatedEntry);
    return { params: { lang, section: sitePages[section].slug[lang], article: slug }, props: { entry, paths, related } };
  });
}) satisfies GetStaticPaths;

const { entry, paths, related } = Astro.props;
const { section, lang, title, description, h1, lead, image, published, updated } = entry.data;
const { Content, headings } = await render(entry);
const url = (path: string) => new URL(path, Astro.site).href;
const day = (date: Date) => date.toISOString().slice(0, 10);
const canonical = url(paths[lang]);
const readingMinutes = Math.max(1, Math.ceil((entry.body ?? "").replace(/<[^>]+>|\[[^\]]+\]\([^\)]+\)|[#*_>`~-]/g, " ").split(/\s+/).filter(Boolean).length / 220));
const texts = pageTexts[lang];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: siteName, item: url(homePath(lang)) },
      { "@type": "ListItem", position: 2, name: dictionaries[lang].footer[section], item: url(pagePath(section, lang)) },
      { "@type": "ListItem", position: 3, name: h1, item: url(paths[lang]) },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${canonical}#article`,
    headline: h1,
    description,
    ...(image ? { image: url(image) } : {}),
    datePublished: day(published),
    dateModified: day(updated ?? published),
    author: { "@type": "Organization", "@id": url("/#organization"), name: siteName, url: url("/") },
    publisher: { "@type": "Organization", "@id": url("/#organization"), name: siteName, url: url("/") },
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
    inLanguage: lang,
    url: canonical,
  },
];
---

<ContentPage lang={lang} title={title} description={description} paths={paths} jsonLd={jsonLd} h1={h1} emoji={sitePages[section].emoji} lead={lead} published={published} updated={updated} isArticle readingMinutes={readingMinutes} image={image ? url(image) : undefined}>
  <nav slot="breadcrumbs" class="breadcrumbs" aria-label={texts.breadcrumbs}>
    <ol>
      <li><a href={homePath(lang)}>{siteName}</a></li>
      <li><a href={pagePath(section, lang)}>{dictionaries[lang].footer[section]}</a></li>
      <li aria-current="page">{h1}</li>
    </ol>
  </nav>
  <ArticleNavigation slot="toc" headings={headings} contentsLabel={texts.contents} progressLabel={texts.readingProgress} />
  <Content />
  <Fragment slot="after">
    <section class="related-articles" aria-labelledby="related-articles-title">
      <h2 id="related-articles-title">{texts.related}</h2>
      <div class="related-grid">
        {related.map(({ data }) => (
          <a class="related-card lift" href={articlePath(data.section, data.slug, data.lang)}>
            <span>{dictionaries[lang].footer[data.section]}</span>
            <h3>{data.h1}</h3>
            <p>{data.description}</p>
          </a>
        ))}
      </div>
    </section>
    <p class="back"><a href={pagePath(section, lang)}>{texts.back[section]}</a></p>
  </Fragment>
</ContentPage>

<style>
  .breadcrumbs { margin: 1.5rem auto 0; font-size: 0.9375rem; color: var(--ink-soft); }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem; margin: 0; padding: 0; list-style: none; }
  .breadcrumbs li { min-width: 0; }
  .breadcrumbs li:not(:last-child)::after { content: "/"; margin-inline-start: 0.375rem; color: var(--line-strong); }
  .breadcrumbs [aria-current="page"] { overflow: hidden; max-width: min(32rem, 70vw); text-overflow: ellipsis; white-space: nowrap; }
  .related-articles { max-width: 48rem; margin: 4rem auto 0; }
  .related-articles h2 { margin-bottom: 1rem; }
  .related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .related-card { position: relative; display: block; padding: 1.25rem; border: 1px solid var(--line); border-radius: var(--radius-panel); background: var(--surface); box-shadow: var(--shadow-panel); color: inherit; text-decoration: none; }
  .related-card > span { color: var(--accent); font-size: 0.8125rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
  .related-card h3 { margin: 0.5rem 0; font-size: 1.25rem; }
  .related-card p { margin: 0; color: var(--ink-soft); }
  .back { max-width: 48rem; margin: 3rem auto 0; font-weight: 700; }
  @media (max-width: 40rem) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
